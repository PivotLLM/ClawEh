#!/bin/sh
# Runs as root from the macOS installer package. The binary sits beside this
# script. It installs the system service for the person at the screen, who
# creates the admin account in their browser before the service starts.
set -eu

dir="$(cd "$(dirname "$0")" && pwd)"

# The account the service runs as: whoever is logged in at the screen.
user="$(/usr/bin/stat -f %Su /dev/console)"
case "$user" in
    "" | root | loginwindow | _mbsetupuser)
        echo "Nobody is logged in at the screen. Log in and run the installer again." >&2
        exit 1
        ;;
esac

exec "$dir/claw" install --yes --browser-setup --user "$user"
