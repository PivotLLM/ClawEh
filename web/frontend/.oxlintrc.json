{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "jsx-a11y",
    "vitest"
  ],
  "ignorePatterns": [
    "dist",
    "src/components/ui",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "jsx-a11y/label-has-associated-control": [
      "warn",
      {
        "controlComponents": [
          "Switch",
          "Input",
          "Textarea",
          "Select"
        ]
      }
    ],
    "vitest/require-mock-type-parameters": "off"
  }
}
