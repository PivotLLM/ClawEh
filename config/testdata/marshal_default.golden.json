  "agents": {
    "list": [
      {
        "id": "claw",
        "default": true,
        "name": "Claw"
      }
    ],
    "base_dir": "/claw-home/agents",
    "defaults": {
      "restrict_to_workspace": true,
      "allow_read_outside_workspace": false,
      "workspace_write_subdir": "files",
      "workspace_read_subdirs": [
        "files",
        "skills"
      ],
      "models": [
        "Claude CLI",
        "Codex CLI"
      ],
      "request_timeout": 300,
      "max_concurrent_turns": 8,
      "max_tokens": 32768,
      "max_tool_iterations": 50,
      "context_window": 128000,
      "archive_days": 365,
      "summary_retention_days": 3650,
      "memory": {
        "prompt": {
          "top_k_domains": 3,
          "max_chars": 4000,
          "min_confidence": 0.65,
          "include_debug_trace": false,
          "file_max_bytes": 262144,
          "file_total_max_bytes": 524288
        },
        "consolidation": {
          "every_n_messages": 50,
          "idle_minutes": 60,
          "nightly": true,
          "nightly_at": "03:20",
          "propose_domains": true,
          "auto_promote": false,
          "debug_dump": false,
          "max_batch_messages": 200,
          "max_input_tokens": 96000,
          "per_message_chars": 12000,
          "max_output_tokens": 8000,
          "max_runtime_seconds": 120
        },
        "retention": {},
        "export": {
          "enabled": true
        }
      }
    }
  },
